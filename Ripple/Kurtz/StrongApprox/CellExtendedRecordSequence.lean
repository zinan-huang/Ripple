-- Ripple/Kurtz/StrongApprox/CellExtendedRecordSequence.lean
import Ripple.Kurtz.StrongApprox.CellExtendedRecordLawInterface

noncomputable section

namespace Ripple.Kurtz.StrongApprox.CellExtendedRecordSequence

open MeasureTheory ProbabilityTheory Set Filter Preorder
open scoped ENNReal NNReal BigOperators
open CellStoppingLineFreshness
open CellExtendedStoppingLine CellExtendedRaceRecursion

variable {ι S : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
variable [Countable S] [MeasurableSpace S] [MeasurableSingletonClass S]
variable [MeasurableSpace ι] [MeasurableSingletonClass ι]

/-- One node of the structural recursion.

`recordTime` is the jump-hold coordinate of the canonical record, not an
accumulated calendar time. -/
structure ExtendedRecordNode (ι S : Type*) where
  recordTime : CellFamily ι → ℝ
  state : CellFamily ι → S
  line : ExtendedCellLine ι

/-- The zero internal-clock line. -/
def initialInternalLine (ι : Type*) : ExtendedCellLine ι :=
  fun _ _ => 0

/-- Initial record node `(0,x0)` at the zero line. -/
noncomputable def initialRecordNode
    (ι : Type*) (x0 : S) : ExtendedRecordNode ι S where
  recordTime := fun _ => 0
  state := fun _ => x0
  line := initialInternalLine ι

/-- One structural successor: race from the current state, store the holding
coordinate and successor state, and retain the new extended line. -/
noncomputable def advanceRecordNode
    (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (q : ExtendedRecordNode ι S) : ExtendedRecordNode ι S :=
  let nextLine := stateNextInternal q.line q.state rate
  let nextValue := nextRecordValue q.line nextLine q.state rate step
  { recordTime := fun c => (nextValue c).1
    state := fun c => (nextValue c).2
    line := nextLine }

/-- The requested single structural recursion on
`(record time, state, extended line)`. -/
noncomputable def recordNode
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S) :
    ℕ → ExtendedRecordNode ι S
  | 0 => initialRecordNode ι x0
  | k + 1 => advanceRecordNode rate step (recordNode x0 rate step k)

/-- Complete diagonal record sequence generated by `recordNode`. -/
noncomputable def recursiveRecord
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (c : CellFamily ι) (k : ℕ) : ℝ × S :=
  let q := recordNode x0 rate step k
  (q.recordTime c, q.state c)

/-- Internal-clock line at record index `k`. -/
noncomputable def recursiveInternal
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (k : ℕ) : ExtendedCellLine ι :=
  (recordNode x0 rate step k).line

/-- Harmless patching record used by the bounded-line approximation inside
the one-step strong memorylessness theorem. -/
def recursiveBase (x0 : S) : ℕ → ℝ × S :=
  fun _ => (0, x0)

@[simp] theorem recursiveRecord_zero
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (c : CellFamily ι) :
    recursiveRecord x0 rate step c 0 = (0, x0) := by
  rfl

@[simp] theorem recursiveInternal_zero
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S) :
    recursiveInternal x0 rate step 0 = initialInternalLine ι := by
  rfl

@[simp] theorem recursiveInternal_succ
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (k : ℕ) :
    recursiveInternal x0 rate step (k + 1) =
      stateNextInternal (recursiveInternal x0 rate step k)
        (fun c => (recursiveRecord x0 rate step c k).2) rate := by
  rfl

@[simp] theorem recursiveRecord_succ
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (c : CellFamily ι) (k : ℕ) :
    recursiveRecord x0 rate step c (k + 1) =
      nextRecordValue
        (recursiveInternal x0 rate step k)
        (recursiveInternal x0 rate step (k + 1))
        (fun z => (recursiveRecord x0 rate step z k).2)
        rate step c := by
  rfl

/-- The zero line is an extended stopping line. -/
theorem initialInternalLine_isExtendedStoppingLine :
    ExtendedCellStoppingLine (initialInternalLine ι) := by
  refine ⟨measurable_const, ?_⟩
  intro u
  have hset :
      extendedLineBelow (initialInternalLine ι) u = Set.univ := by
    ext c
    simp [extendedLineBelow, initialInternalLine]
  rw [hset]
  exact MeasurableSet.univ

/-- The zero line is pointwise finite, hence finite almost surely. -/
theorem initialInternalLine_finite_ae :
    ∀ᵐ c ∂cellFamilyLaw ι,
      c ∈ extendedLineFinite (initialInternalLine ι) := by
  filter_upwards [] with c
  simp [extendedLineFinite, initialInternalLine]

/-- The index-zero record history is constant. -/
theorem recursiveRecordPrefix_zero
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S) :
    recordPrefix (recursiveRecord x0 rate step) 0 =
      fun _ _ => (0, x0) := by
  funext c j
  rcases j with ⟨j, hj⟩
  have hjzero : j = 0 :=
    Nat.le_zero.mp (Finset.mem_Iic.mp hj)
  subst j
  rfl

/-- Replacing exactly record `k+1` preserves the complete prefix through
`k+1`, provided the replacement is the actual next record. -/
theorem recordPrefix_extendRecord_succ
    (R : CellFamily ι → ℕ → ℝ × S) (k : ℕ)
    (nextValue : CellFamily ι → ℝ × S)
    (hnext : ∀ c, R c (k + 1) = nextValue c) :
    recordPrefix (extendRecord R k nextValue) (k + 1) =
      recordPrefix R (k + 1) := by
  funext c j
  by_cases hj : j.val = k + 1
  · simpa [recordPrefix, extendRecord, hj] using (hnext c).symm
  · simp [recordPrefix, extendRecord, hj]

/-- Per-index induction package.  This is deliberately only the three inputs
needed to invoke the next one-step memorylessness theorem; freshness is then recovered uniformly
from the completed extended filtration realization. -/
structure RecursiveRecordIndexReceipt
    (R : CellFamily ι → ℕ → ℝ × S)
    (internal : ℕ → ExtendedCellLine ι) (k : ℕ) : Prop where
  stopping : ExtendedCellStoppingLine (internal k)
  finite :
    ∀ᵐ c ∂cellFamilyLaw ι,
      c ∈ extendedLineFinite (internal k)
  history :
    Measurable[extendedStoppedPast (internal k) stopping]
      (recordPrefix R k)

/-- Iteration of `oneStepExtendedRecordRecursion` over every record index. -/
theorem recursiveRecordIndexReceipt
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (hrate : Measurable rate)
    (hpositive : ∀ x l, 0 < rate x l)
    (hstep : Measurable (Function.uncurry step))
    (k : ℕ) :
    RecursiveRecordIndexReceipt
      (recursiveRecord x0 rate step)
      (recursiveInternal x0 rate step) k := by
  induction k with
  | zero =>
      have hline : ExtendedCellStoppingLine
          (recursiveInternal x0 rate step 0) := by
        simpa only [recursiveInternal_zero] using
          (initialInternalLine_isExtendedStoppingLine (ι := ι))
      have hfinite :
          ∀ᵐ c ∂cellFamilyLaw ι,
            c ∈ extendedLineFinite
              (recursiveInternal x0 rate step 0) := by
        simpa only [recursiveInternal_zero] using
          (initialInternalLine_finite_ae (ι := ι))
      have hhistory :
          Measurable[extendedStoppedPast
            (recursiveInternal x0 rate step 0) hline]
            (recordPrefix (recursiveRecord x0 rate step) 0) := by
        rw [recursiveRecordPrefix_zero x0 rate step]
        exact measurable_const
      exact
        { stopping := hline
          finite := hfinite
          history := hhistory }
  | succ k ih =>
      let currentState : CellFamily ι → S :=
        fun c => (recursiveRecord x0 rate step c k).2
      let nextLine : ExtendedCellLine ι :=
        stateNextInternal
          (recursiveInternal x0 rate step k) currentState rate
      let nextValue : CellFamily ι → ℝ × S :=
        nextRecordValue
          (recursiveInternal x0 rate step k)
          nextLine currentState rate step
      have hstepResult :
          ∃ hnextLine : ExtendedCellStoppingLine nextLine,
            Measurable[extendedStoppedPast nextLine hnextLine]
                (recordPrefix
                  (extendRecord
                    (recursiveRecord x0 rate step) k nextValue)
                  (k + 1)) ∧
              (∀ᵐ c ∂cellFamilyLaw ι,
                c ∈ extendedLineFinite nextLine) ∧
              FreshResidualsAt (cellFamilyLaw ι)
                (extendRecord
                  (recursiveRecord x0 rate step) k nextValue)
                (extendedStoppingResidual nextLine) (k + 1) := by
        simpa only [currentState, nextLine, nextValue] using
          (oneStepExtendedRecordRecursion
            (R := recursiveRecord x0 rate step)
            (k := k)
            (σ := recursiveInternal x0 rate step k)
            ih.stopping ih.history ih.finite
            (recursiveBase x0)
            (rate := rate) hrate hpositive
            (step := step) hstep)
      have hlineEq :
          nextLine = recursiveInternal x0 rate step (k + 1) := by
        rfl
      rw [hlineEq] at hstepResult
      rcases hstepResult with
        ⟨hline, hhistoryNext, hfiniteNext, _⟩
      have hvalue (c : CellFamily ι) :
          recursiveRecord x0 rate step c (k + 1) =
            nextValue c := by
        rfl
      have hrecords :
          recordPrefix
              (extendRecord
                (recursiveRecord x0 rate step) k nextValue)
              (k + 1) =
            recordPrefix (recursiveRecord x0 rate step) (k + 1) :=
        recordPrefix_extendRecord_succ
          (recursiveRecord x0 rate step) k nextValue hvalue
      have hhistory :
          Measurable[extendedStoppedPast
            (recursiveInternal x0 rate step (k + 1)) hline]
            (recordPrefix
              (recursiveRecord x0 rate step) (k + 1)) := by
        rw [← hrecords]
        exact hhistoryNext
      exact
        { stopping := hline
          finite := hfiniteNext
          history := hhistory }

/-- The full recursive record and all extended internal lines form the exact
replacement filtration package. -/
theorem recursiveCellRecordFiltrationRealization
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (hrate : Measurable rate)
    (hpositive : ∀ x l, 0 < rate x l)
    (hstep : Measurable (Function.uncurry step)) :
    ExtendedCellRecordFiltrationRealization
      (recursiveRecord x0 rate step)
      (recursiveInternal x0 rate step) := by
  let H : ∀ k,
      RecursiveRecordIndexReceipt
        (recursiveRecord x0 rate step)
        (recursiveInternal x0 rate step) k :=
    fun k =>
      recursiveRecordIndexReceipt
        x0 rate step hrate hpositive hstep k
  exact
    { stopping := fun k => (H k).stopping
      finite := fun k => (H k).finite
      history := fun k => (H k).history }

/-- Fresh iid unit-exponential residual clocks at every recursive record
index. -/
theorem recursiveRecord_freshResidualsAt
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (hrate : Measurable rate)
    (hpositive : ∀ x l, 0 < rate x l)
    (hstep : Measurable (Function.uncurry step))
    (k : ℕ) :
    FreshResidualsAt (cellFamilyLaw ι)
      (recursiveRecord x0 rate step)
      (extendedStoppingResidual
        (recursiveInternal x0 rate step k)) k :=
  ExtendedCellRecordFiltrationRealization.freshResidualsAt
    (recursiveCellRecordFiltrationRealization
      x0 rate step hrate hpositive hstep)
    (recursiveBase x0) k

/-- Ambient measurability of the complete infinite record map. -/
theorem recursiveRecord_measurable
    (x0 : S) (rate : S → ι → ℝ≥0) (step : S → ι → S)
    (hrate : Measurable rate)
    (hpositive : ∀ x l, 0 < rate x l)
    (hstep : Measurable (Function.uncurry step)) :
    Measurable (recursiveRecord x0 rate step) :=
  (recursiveCellRecordFiltrationRealization
    x0 rate step hrate hpositive hstep).measurable_record

