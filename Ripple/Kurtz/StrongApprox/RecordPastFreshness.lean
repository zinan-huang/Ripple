-- Ripple/Kurtz/StrongApprox/RecordPastFreshness.lean
import Ripple.Kurtz.StrongApprox.PoissonDeterministicRenewal

noncomputable section

namespace Ripple.Kurtz.StrongApprox

open MeasureTheory ProbabilityTheory Set Preorder
open scoped ENNReal BigOperators
open ExponentialRace

variable {Ω S ι : Type*}
variable [MeasurableSpace Ω] [MeasurableSpace S]
variable [Fintype ι] [DecidableEq ι]

/-- The first `k+1` records, including the current record. -/
def recordPrefix (R : Ω → ℕ → ℝ × S) (k : ℕ) (ω : Ω) :
    (i : Finset.Iic k) → ℝ × S :=
  frestrictLe (π := fun _ : ℕ => ℝ × S) k (R ω)

/-- The sigma algebra generated by the finite record prefix.  This is the
correct meaning of “complete past at record `k`”. -/
def recordPast (R : Ω → ℕ → ℝ × S) (k : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (recordPrefix R k) inferInstance

/-- Factorization form of “conditional on the record prefix, the residual
clocks are fresh iid unit exponentials”. -/
structure FreshResidualsAt
    (μ : Measure Ω) (R : Ω → ℕ → ℝ × S)
    (residual : Ω → ι → ℝ) (k : ℕ) : Prop where
  measurable_history : Measurable (recordPrefix R k)
  measurable_residual : Measurable residual
  joint_law :
    μ.map (fun ω => (recordPrefix R k ω, residual ω)) =
      (μ.map (recordPrefix R k)).prod (clockLaw ι)

namespace FreshResidualsAt

variable {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {R : Ω → ℕ → ℝ × S} {residual : Ω → ι → ℝ} {k : ℕ}
variable (H : FreshResidualsAt μ R residual k)
include H

/-- Product-cylinder form of the conditional factorization. -/
theorem measure_history_residual
    {A : Set ((i : Finset.Iic k) → ℝ × S)} {B : Set (ι → ℝ)}
    (hA : MeasurableSet A) (hB : MeasurableSet B) :
    μ {ω | recordPrefix R k ω ∈ A ∧ residual ω ∈ B} =
      (μ.map (recordPrefix R k)) A * clockLaw ι B := by
  have h := congrArg
    (fun ν : Measure (((i : Finset.Iic k) → ℝ × S) × (ι → ℝ)) =>
      ν (A ×ˢ B)) H.joint_law
  dsimp only at h
  rw [Measure.map_apply
      (H.measurable_history.prodMk H.measurable_residual) (hA.prod hB),
    Measure.prod_prod] at h
  simpa only [mem_preimage, Set.mem_prod, mem_setOf_eq] using h

/-- The residual vector has the iid unit-exponential law. -/
theorem residual_law : μ.map residual = clockLaw ι := by
  ext B hB
  rw [Measure.map_apply H.measurable_residual hB]
  have h := H.measure_history_residual (A := Set.univ) (B := B)
    MeasurableSet.univ hB
  simpa [Measure.map_apply H.measurable_history MeasurableSet.univ] using h

/-- The record prefix and the residual vector are independent. -/
theorem indep_recordPrefix_residual :
    IndepFun (recordPrefix R k) residual μ := by
  rw [indepFun_iff_map_prod_eq_prod_map_map
    H.measurable_history.aemeasurable H.measurable_residual.aemeasurable,
    H.joint_law, H.residual_law]

/-- Conditional winner probability on every measurable history event. -/
theorem winner_on_history
    {A : Set ((i : Finset.Iic k) → ℝ × S)} (hA : MeasurableSet A)
    (t : ι → ℝ) (ht : ∀ i, 0 < t i) (htotal : ∑ i, t i = 1)
    (a : ι) :
    μ {ω | recordPrefix R k ω ∈ A ∧
      strictClockWin t a (residual ω)} =
      (μ.map (recordPrefix R k)) A * ENNReal.ofReal (t a) := by
  refine Eq.trans (H.measure_history_residual hA
    (strictClockWin_measurableSet t a)) ?_
  rw [strictClockWin_measure t ht htotal a]

/-- On a fixed winner cell and every history event, the transformed residual
vector is fresh iid `Exp(1)`. -/
theorem postRace_residual_on_history
    {A : Set ((i : Finset.Iic k) → ℝ × S)} (hA : MeasurableSet A)
    (t : ι → ℝ) (ht : ∀ i, 0 < t i) (htotal : ∑ i, t i = 1)
    (a : ι) {C : Set (ι → ℝ)} (hC : MeasurableSet C) :
    μ {ω | recordPrefix R k ω ∈ A ∧
      strictClockWin t a (residual ω) ∧
      winnerResidualClock t a (residual ω) ∈ C} =
      (μ.map (recordPrefix R k)) A *
        (ENNReal.ofReal (t a) * clockLaw ι C) := by
  have hwin := strictClockWin_measurableSet t a
  have hres := winnerResidualClock_measurable t a
  have hB : MeasurableSet
      {E : ι → ℝ | strictClockWin t a E ∧
        winnerResidualClock t a E ∈ C} :=
    hwin.inter (hC.preimage hres)
  have hmap := winnerResidualClock_restrict_law t ht htotal a
  have hclock :
      clockLaw ι {E : ι → ℝ | strictClockWin t a E ∧
        winnerResidualClock t a E ∈ C} =
        ENNReal.ofReal (t a) * clockLaw ι C := by
    have hc := congrArg (fun ν : Measure (ι → ℝ) => ν C) hmap
    dsimp only at hc
    rw [Measure.map_apply hres hC,
      Measure.restrict_apply (hC.preimage hres),
      Measure.smul_apply, smul_eq_mul] at hc
    simpa [Set.inter_comm, Set.inter_left_comm, Set.inter_assoc] using hc
  refine Eq.trans (H.measure_history_residual hA hB) ?_
  rw [hclock]

/-- Conditional survival of the race minimum. -/
theorem race_survival_on_history
    [Nonempty ι]
    {A : Set ((i : Finset.Iic k) → ℝ × S)} (hA : MeasurableSet A)
    (r : ι → ℝ) (hr : ∀ i, 0 < r i)
    {u : ℝ} (hu : 0 ≤ u) :
    μ {ω | recordPrefix R k ω ∈ A ∧
      ∀ i, u < residual ω i / r i} =
      (μ.map (recordPrefix R k)) A *
        ENNReal.ofReal (Real.exp (-(rateTotal r * u))) := by
  have hB : MeasurableSet {E : ι → ℝ | ∀ i, u < E i / r i} := by
    simp only [Set.setOf_forall]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const
        (by fun_prop : Measurable fun E : ι → ℝ => E i / r i) :
        MeasurableSet {E : ι → ℝ | u < E i / r i})
  refine Eq.trans (H.measure_history_residual hA hB) ?_
  rw [raceSurvival_measure r hr hu]

/-- Joint winner/holding law on every measurable history event. -/
theorem winner_wait_on_history
    [Nonempty ι]
    {A : Set ((i : Finset.Iic k) → ℝ × S)} (hA : MeasurableSet A)
    (r : ι → ℝ) (hr : ∀ i, 0 < r i) (a : ι)
    {B : Set ℝ} (hB : MeasurableSet B) :
    μ {ω | recordPrefix R k ω ∈ A ∧
      strictClockWin r a (residual ω) ∧ residual ω a / r a ∈ B} =
      (μ.map (recordPrefix R k)) A *
        (ENNReal.ofReal (r a / rateTotal r) *
          expMeasure (rateTotal r) B) := by
  have hwin := strictClockWin_measurableSet r a
  have hwait : Measurable (fun E : ι → ℝ => E a / r a) := by fun_prop
  have hC : MeasurableSet
      {E : ι → ℝ | strictClockWin r a E ∧ E a / r a ∈ B} :=
    hwin.inter (hB.preimage hwait)
  have hmap := winnerWait_restrict_law_of_rates r hr a
  have hclock :
      clockLaw ι {E : ι → ℝ | strictClockWin r a E ∧ E a / r a ∈ B} =
        ENNReal.ofReal (r a / rateTotal r) *
          expMeasure (rateTotal r) B := by
    have hb := congrArg (fun ν : Measure ℝ => ν B) hmap
    dsimp only at hb
    rw [Measure.map_apply hwait hB,
      Measure.restrict_apply (hB.preimage hwait),
      Measure.smul_apply, smul_eq_mul] at hb
    simpa [Set.inter_comm, Set.inter_left_comm, Set.inter_assoc] using hb
  refine Eq.trans (H.measure_history_residual hA hC) ?_
  rw [hclock]

end FreshResidualsAt

end Ripple.Kurtz.StrongApprox

end
