import Ripple.Stochastic.BrownianMotion.Gaussian.BrownianMotion
import Mathlib.Probability.Distributions.Gaussian.HasGaussianLaw.Independence

/-!
# The common natural filtration of independent Brownian coordinates

Independent coordinate path laws and scalar Brownian finite-dimensional laws
give independence of the entire future-increment vector from the entire past.
The natural filtration is generated by Brownian evaluations alone.
-/

noncomputable section

namespace Ripple.Stochastic.IndependentBrownianFiltration

open MeasureTheory ProbabilityTheory MeasureTheory.Filtration
open scoped NNReal ENNReal

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  {P : Measure Ω} [IsProbabilityMeasure P]
  {B : ι → ℝ≥0 → Ω → ℝ}

/-- Natural filtration of the vector of all coordinates. -/
def vectorNatural (B : ι → ℝ≥0 → Ω → ℝ)
    (hB : ∀ i t, Measurable (B i t)) : Filtration ℝ≥0 ‹MeasurableSpace Ω› :=
  natural (fun t ω i => B i t ω)
    (fun t => (measurable_pi_lambda _ (fun i => hB i t)).stronglyMeasurable)

/-- Independent Gaussian coordinate processes are jointly Gaussian when both
the coordinate and the time are included in the index. -/
theorem tagged_isGaussianProcess
    (hg : ∀ i, IsGaussianProcess (B i) P)
    (hind : iIndepFun (fun i ω t => B i t ω) P) :
    IsGaussianProcess (fun p : ι × ℝ≥0 => B p.1 p.2) P where
  hasGaussianLaw I := by
    classical
    let K : Finset ℝ≥0 := I.image Prod.snd
    let F (i : ι) (ω : Ω) : K → ℝ := fun t => B i t ω
    have hF : ∀ i, HasGaussianLaw (F i) P := fun i => (hg i).hasGaussianLaw K
    have hiF : iIndepFun F P := by
      exact hind.comp (fun _ f (t : K) => f t)
        (fun _ => measurable_pi_lambda _ fun t => measurable_pi_apply (t : ℝ≥0))
    let L : (ι → K → ℝ) →L[ℝ] (I → ℝ) :=
      { toFun := fun x p => x p.1.1 ⟨p.1.2, Finset.mem_image.mpr ⟨p.1, p.2, rfl⟩⟩
        map_add' := by intros; rfl
        map_smul' := by intros; rfl
        cont := by fun_prop }
    simpa [L, F, Finset.restrict] using (hiF.hasGaussianLaw hF).map L

/-- Distinct coordinate evaluations are uncorrelated, at arbitrary times. -/
theorem covariance_ne
    (hB : ∀ i, IsPreBrownian (B i) P)
    (hind : iIndepFun (fun i ω t => B i t ω) P)
    {i j : ι} (hij : i ≠ j) (s t : ℝ≥0) :
    cov[B i s, B j t; P] = 0 := by
  letI := hB i
  letI := hB j
  have hi := (hind.indepFun hij).comp (φ := fun f : ℝ≥0 → ℝ => f s)
    (ψ := fun f : ℝ≥0 → ℝ => f t)
    (measurable_pi_apply s : Measurable fun f : ℝ≥0 → ℝ => f s)
    (measurable_pi_apply t : Measurable fun f : ℝ≥0 → ℝ => f t)
  exact hi.covariance_eq_zero
    ((hB i).isGaussianProcess.hasGaussianLaw_eval s).memLp_two
    ((hB j).isGaussianProcess.hasGaussianLaw_eval t).memLp_two

/-- All future increments jointly, across all coordinates, are independent of
the whole vector past. The two function spaces carry cylinder sigma-algebras. -/
theorem future_indep_past
    (hB : ∀ i, IsPreBrownian (B i) P)
    (hm : ∀ i t, Measurable (B i t))
    (hind : iIndepFun (fun i ω t => B i t ω) P) (s : ℝ≥0) :
    IndepFun (fun ω (p : ι × ℝ≥0) => B p.1 (s + p.2) ω - B p.1 s ω)
      (fun ω (p : ι × Set.Iic s) => B p.1 p.2 ω) P := by
  classical
  have hg := tagged_isGaussianProcess (fun i => (hB i).isGaussianProcess) hind
  apply IsGaussianProcess.indepFun''
  · apply hg.of_isGaussianProcess
    rintro (⟨i, u⟩ | ⟨i, t⟩)
    · let I : Finset (ι × ℝ≥0) := {(i, s + u), (i, s)}
      let L : (I → ℝ) →L[ℝ] ℝ :=
        { toFun := fun x => x ⟨(i, s + u), by simp [I]⟩ - x ⟨(i, s), by simp [I]⟩
          map_add' := by intros; simp; abel
          map_smul' := by intros; simp; ring
          cont := by fun_prop }
      exact ⟨I, L, fun ω => by simp [L, Finset.restrict]⟩
    · let I : Finset (ι × ℝ≥0) := {(i, t.1)}
      let L : (I → ℝ) →L[ℝ] ℝ :=
        { toFun := fun x => x ⟨(i, t.1), by simp [I]⟩
          map_add' := by intros; rfl
          map_smul' := by intros; rfl
          cont := by fun_prop }
      exact ⟨I, L, fun ω => by simp [L, Finset.restrict]⟩
  · rintro ⟨i, u⟩
    exact (hm i _).sub (hm i _)
  · rintro ⟨i, t⟩
    exact hm i t
  · rintro ⟨i, u⟩ ⟨j, t⟩
    rw [covariance_fun_sub_left
      ((hB i).isGaussianProcess.hasGaussianLaw_eval _).memLp_two
      ((hB i).isGaussianProcess.hasGaussianLaw_eval _).memLp_two
      ((hB j).isGaussianProcess.hasGaussianLaw_eval _).memLp_two]
    by_cases hij : i = j
    · subst j
      letI := hB i
      have hfuture : cov[B i (s + u), B i t; P] = (t : ℝ) := by
        rw [(hB i).covariance_eval, min_eq_right]
        exact_mod_cast t.2.trans (le_add_of_nonneg_right (zero_le : (0 : ℝ≥0) ≤ u))
      have hpast : cov[B i s, B i t; P] = (t : ℝ) := by
        rw [(hB i).covariance_eval, min_eq_right]
        exact_mod_cast t.2
      rw [hfuture, hpast, sub_self]
    · rw [covariance_ne hB hind hij, covariance_ne hB hind hij, sub_self]

/-- The sigma-algebra generated by vector evaluations before `s` is contained
in the sigma-algebra of the tagged past path. -/
theorem vectorNatural_le_past (hm : ∀ i t, Measurable (B i t)) (s : ℝ≥0) :
    vectorNatural B hm s ≤ MeasurableSpace.comap
      (fun ω (p : ι × Set.Iic s) => B p.1 p.2 ω) inferInstance := by
  change (⨆ u ≤ s, MeasurableSpace.comap (fun ω i => B i u ω) inferInstance) ≤ _
  refine iSup_le fun u => iSup_le fun hu => ?_
  have heq : (fun ω i => B i u ω) =
      (fun f i => f (i, ⟨u, hu⟩)) ∘ (fun ω (p : ι × Set.Iic s) => B p.1 p.2 ω) := rfl
  rw [heq, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (Measurable.comap_le
    (measurable_pi_lambda _ fun i => measurable_pi_apply (i, (⟨u, hu⟩ : Set.Iic s))))

/-- Every scalar coordinate is a filtered Brownian motion for the same vector
natural filtration, so random integrands may depend on every coordinate. -/
theorem isFilteredPreBrownian_vectorNatural
    (hB : ∀ i, IsPreBrownian (B i) P)
    (hm : ∀ i t, Measurable (B i t))
    (hind : iIndepFun (fun i ω t => B i t ω) P) (i : ι) :
    IsFilteredPreBrownian (B i) (vectorNatural B hm) P where
  toIsPreBrownian := hB i
  stronglyAdapted t := by
    have ht := stronglyAdapted_natural
      (fun t => (measurable_pi_lambda _ (fun j => hm j t)).stronglyMeasurable) t
    exact ((measurable_pi_apply i).comp ht.measurable).stronglyMeasurable
  indep s t hst := by
    have h := (future_indep_past hB hm hind s).comp
      (φ := fun f : ι × ℝ≥0 → ℝ => f (i, t - s)) (ψ := id)
      (measurable_pi_apply (i, t - s) : Measurable fun f : ι × ℝ≥0 → ℝ => f (i, t - s))
      measurable_id
    have h' : IndepFun (B i t - B i s)
        (fun ω (p : ι × Set.Iic s) => B p.1 p.2 ω) P := by
      simpa only [Function.comp_def, id_eq, add_tsub_cancel_of_le hst] using h
    exact indep_of_indep_of_le_right ((IndepFun_iff_Indep _ _ _).mp h')
      (vectorNatural_le_past hm s)

/-- Independence from the common past holds for the whole increment vector,
which is stronger than separate coordinate independence. -/
theorem vectorIncrement_indep_natural
    (hB : ∀ i, IsPreBrownian (B i) P)
    (hm : ∀ i t, Measurable (B i t))
    (hind : iIndepFun (fun i ω t => B i t ω) P)
    {s t : ℝ≥0} (hst : s ≤ t) :
    Indep (MeasurableSpace.comap (fun ω i => B i t ω - B i s ω) inferInstance)
      (vectorNatural B hm s) P := by
  have h := (future_indep_past hB hm hind s).comp
    (φ := fun (f : ι × ℝ≥0 → ℝ) (i : ι) => f (i, t - s)) (ψ := id)
    (measurable_pi_lambda _ fun i => measurable_pi_apply _) measurable_id
  have h' : IndepFun (fun ω i => B i t ω - B i s ω)
      (fun ω (p : ι × Set.Iic s) => B p.1 p.2 ω) P := by
    simpa only [Function.comp_def, id_eq, add_tsub_cancel_of_le hst] using h
  exact indep_of_indep_of_le_right ((IndepFun_iff_Indep _ _ _).mp h')
    (vectorNatural_le_past hm s)

/-- Every coordinate increment has variance `t-s`, including the degenerate
case `s=t`. No dyadic restriction occurs in this interface. -/
theorem increment_hasLaw (hB : ∀ i, IsPreBrownian (B i) P)
    (i : ι) {s t : ℝ≥0} (hst : s ≤ t) :
    HasLaw (fun ω => B i t ω - B i s ω) (gaussianReal 0 (t - s)) P := by
  letI := hB i
  simpa only [tsub_eq_zero_of_le hst, max_eq_left (zero_le : (0 : ℝ≥0) ≤ t - s), Pi.sub_apply]
    using (hB i).hasLaw_sub t s

/-- The increment vector has the product of centered Gaussian laws with
variance `t-s`; in Euclidean coordinates its covariance is `(t-s) I`. -/
theorem vectorIncrement_hasLaw
    (hB : ∀ i, IsPreBrownian (B i) P)
    (hm : ∀ i t, Measurable (B i t))
    (hind : iIndepFun (fun i ω t => B i t ω) P)
    {s t : ℝ≥0} (hst : s ≤ t) :
    HasLaw (fun ω i => B i t ω - B i s ω)
      (Measure.pi fun _ : ι => gaussianReal 0 (t - s)) P := by
  have hi : iIndepFun (fun i ω => B i t ω - B i s ω) P :=
    hind.comp (fun _ f => f t - f s)
      (fun _ => (measurable_pi_apply t).sub (measurable_pi_apply s))
  refine ⟨(measurable_pi_lambda _ fun i => (hm i t).sub (hm i s)).aemeasurable, ?_⟩
  rw [hi.map_fun_eq_pi_map (fun i => ((hm i t).sub (hm i s)).aemeasurable)]
  congr 1
  funext i
  exact (increment_hasLaw hB i hst).map_eq

end Ripple.Stochastic.IndependentBrownianFiltration
